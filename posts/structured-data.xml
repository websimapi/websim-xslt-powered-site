            <section id="complex-content">
                <h2>Mixed Content Types</h2>
                <p>XML can seamlessly handle mixed content with different formatting requirements:</p>
                
                <mixedContent>
                    <paragraph>This is regular paragraph content with <emphasis>emphasized text</emphasis> and <code>inline code</code>.</paragraph>
                    <codeBlock language="xslt">
                        <xsl:template match="emphasis">
                          <em><xsl:value-of select="."/></em>
                        </xsl:template>
                    </codeBlock>
                    <list type="ordered">
                        <item>First item with <link href="https://example.com">external link</link></item>
                        <item>Second item with nested content:
                            <sublist>
                                <item>Nested item A</item>
                                <item>Nested item B</item>
                            </sublist>
                        </item>
                        <item>Third item</item>
                    </list>
                </mixedContent>
